# Salin berkas ini menjadi .env.local di akar repo, lalu isi nilainya.
# Berkas .env.local tidak ikut masuk repositori karena sudah diabaikan git.

# Alamat backend FastAPI. Docker compose memakai port 8000.
VITE_API_URL=http://localhost:8000/api/v1

# Nilai di bawah ini diambil dari dashboard Supabase, menu Project Settings lalu API.
# Pakai anon key atau publishable key, jangan pakai service role key.
VITE_SUPABASE_URL=https://proyek-anda.supabase.co
VITE_SUPABASE_ANON_KEY=isi_dengan_anon_key_atau_publishable
